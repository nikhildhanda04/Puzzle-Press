PORT=4000
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-pooler.REGION.aws.neon.tech/puzzle_press?sslmode=require&pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://USER:PASSWORD@ep-example.REGION.aws.neon.tech/puzzle_press?sslmode=require"
PUBLIC_SITE_URL="http://localhost:5173"
BETTER_AUTH_SECRET="generate-a-random-secret-at-least-32-characters-long"
BETTER_AUTH_URL="http://localhost:4000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Comma-separated Google accounts allowed into /api/admin. Empty means nobody.
ADMIN_EMAILS=""
# From Google AI Studio. Without it, generation returns placeholder drafts instead of Gemini output.
GEMINI_API_KEY=""
# Comma-separated, tried in order. Later entries catch rate limits, retired ids, and bad drafts.
# Confirm against `npm run ai:check`, which lists the model ids your key can use.
GEMINI_MODEL="gemini-3.1-flash-lite,gemini-3.6-flash,gemini-flash-latest"
# Number of reverse proxy hops in front of the app. Leave unset when running directly.
TRUST_PROXY=""
RESEND_API_KEY=""
EMAIL_FROM="Puzzle Press <issues@example.com>"
